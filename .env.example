APP_NAME=ZYRO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# --- PRODUCCIÓN (Railway) ---
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://zyro-production.up.railway.app
# SESSION_SECURE_COOKIE=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=zyro_store
DB_USERNAME=root
DB_PASSWORD=

ADMIN_NAME="Administrador ZYRO"
ADMIN_EMAIL=admin@zyro.test
ADMIN_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Broadcasting & WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- CONFIGURACIÓN DE REVERB EN RAILWAY (PRODUCCIÓN) ---
# En Railway, Reverb se puede desplegar como servicio WebSocket en HTTPS/WSS:
# REVERB_HOST="tu-servicio-reverb.up.railway.app"
# REVERB_PORT=443
# REVERB_SCHEME=https
# VITE_REVERB_HOST="tu-servicio-reverb.up.railway.app"
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
# Comando de ejecución en Railway: php artisan reverb:start --host=0.0.0.0 --port=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Configuración comercial
# Tasa de IVA (decimal). Ejemplo: 0.15 = 15 %.
IVA_RATE=0.15
# Costo fijo de envío (USD).
SHIPPING_COST=6.00

# Microsoft Clarity (Analítica y Mapas de Calor)
CLARITY_PROJECT_ID=
